# BC API base URL — used by the Vite dev proxy locally; set as a Cloud Run env var
# in production so nginx substitutes it at container startup (same mechanism as the
# garments app, rgmc-consignment-webapp). This app calls only relative /food/* paths
# at runtime, so nothing here ever gets baked into the production JS bundle.
VITE_API_BASE_URL=https://rgmc-bc-api-staging-935246372408.asia-southeast1.run.app

# Shared internal IT/MIS reporting portal — same service the garments app
# (rgmc-consignment-webapp) reports to. A stable, cross-app constant, so it
# is baked at build time rather than runtime-injected like VITE_API_BASE_URL.
VITE_GATEWAY_URL=https://rgmc-gateway-935246372408.asia-southeast1.run.app
