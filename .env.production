# Mirrors rgmc-consignment-webapp's split between .env (dev) and .env.production
# (values baked into the production bundle). This app has no build-time-only public
# URLs to bake in — VITE_API_BASE_URL is deliberately NOT set here; it is instead
# read as a real runtime environment variable by docker-entrypoint.sh, which
# envsubst's it into nginx.conf at container startup, exactly like the garments app.

# Shared internal IT/MIS reporting portal — a stable, cross-app constant
# (unlike VITE_API_BASE_URL, which varies per environment), so it's baked in
# here exactly like the garments app's own .env.production.
VITE_GATEWAY_URL=https://rgmc-gateway-935246372408.asia-southeast1.run.app
